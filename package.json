// TELEGRAM BOT
// =====================================================

const bot =
  new TelegramBot(
    TOKEN,
    {
      baseApiUrl:
        (
          process.env.TELEGRAM_BOT_API_BASE_URL ||
          'https://api.telegram.org'
        ).replace(/\/$/, ''),

      polling: {
        autoStart: true,

        params: {
          timeout: 10
        }
      }
    }
  );


bot.on(
  'polling_error',
  async (error) => {

    console.error(
      '[Polling Error]',
      error.message
    );

    if (
      error.message &&
      error.message.includes(
        '409 Conflict'
      )
    ) {

      await new Promise(
        resolve =>
          setTimeout(
            resolve,
            4000
          )
      );
    }
  }
);


// =====================================================
// HTML ESCAPE
// =====================================================

function escapeHtml(
  str = ''
) {

  return String(str).replace(
    /[&<>"']/g,

    (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[c])
  );
}


