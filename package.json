// =====================================================
// VIDEO HANDLER
// =====================================================

bot.on(
  'message',
  async (msg) => {

    const chatId =
      msg.chat.id;


    const uploaderName =
      msg.from?.username
        ? `@${msg.from.username}`
        : (
            msg.from?.first_name ||
            'User'
          );


    // -----------------------------------------------
    // VIDEO / DOCUMENT / ANIMATION
    // -----------------------------------------------

    const videoObj =
      msg.video ||
      msg.document ||
      msg.animation ||
      null;


    if (videoObj) {

      const fileId =
        videoObj.file_id;


      const fileName =
        videoObj.file_name ||
        `video_${Date.now()}.mp4`;


      const mimeType =
        videoObj.mime_type ||
        'video/mp4';


      const statusMsg =
        await bot.sendMessage(

          chatId,

          `⚡ <i>Video Telegram Channel mein save ho rahi hai...</i>`,

          {
            parse_mode:
              'HTML'
          }
        );


      try {

        // -------------------------------------------
        // CHANNEL ID
        // -------------------------------------------

        const channelId =
          process.env.CHANNEL_ID;


        if (!channelId) {

          throw new Error(
            'CHANNEL_ID environment variable missing'
          );
        }


        // -------------------------------------------
        // COPY ORIGINAL MESSAGE
        //
        // Telegram server par existing file ko
        // dobara upload/download nahi karta.
        // -------------------------------------------

        const copied =
          await bot.copyMessage(

            channelId,

            chatId,

            msg.message_id,

            {
              disable_notification:
                true
            }
          );


        // -------------------------------------------
        // COPY MESSAGE ID
        // -------------------------------------------

        const channelMessageId =
          copied.message_id;


        // -------------------------------------------
        // TELEGRAM FILE ID
        // -------------------------------------------

        const telegramFileId =
          fileId;


        if (!telegramFileId) {

          throw new Error(
            'Telegram file_id missing'
          );
        }


        // -------------------------------------------
        // CREATE SHORT PLAYER ID
        // -------------------------------------------

        const shortId =
          crypto
            .randomBytes(6)
            .toString('hex');


        // -------------------------------------------
        // SAVE ONLY METADATA
        //
        // Video R2 mein nahi ja rahi.
        // -------------------------------------------

        const payload = {

          name:
            fileName,

          telegramFileId:
            telegramFileId,

          channelId:
            String(channelId),

          channelMessageId:
            channelMessageId,

          mime_type:
            mimeType,

          uploader:
            uploaderName,

          created_at:
            Date.now()
        };


        // -------------------------------------------
        // MEMORY
        // -------------------------------------------

        linkStore.set(
          shortId,
          payload
        );


        // -------------------------------------------
        // REDIS
        // -------------------------------------------

        await redis.set(

          `video:${shortId}`,

          JSON.stringify(
            payload
          ),

          {
            // 10 years
            ex:
              3650 * 86400
          }
        );


        // -------------------------------------------
        // PLAYER LINK
        // -------------------------------------------

        const playUrl =
          `${BASE_URL}/v/${shortId}`;


        // -------------------------------------------
        // DELETE STATUS
        // -------------------------------------------

        await bot
          .deleteMessage(
            chatId,
            statusMsg.message_id
          )
          .catch(
            () => {}
          );


        // -------------------------------------------
        // SEND RESULT TO USER
        // -------------------------------------------

        return bot.sendMessage(

          chatId,

          `✨ <b>Video Ready!</b>

📌 <b>File:</b>
${escapeHtml(fileName)}

📺 <b>Telegram Channel:</b>
✅ Saved

🔗 <b>Your Player Link:</b>
${playUrl}`,

          {
            parse_mode:
              'HTML',

            disable_web_page_preview:
              false
          }
        );


      } catch (err) {

        console.error(
          '[TELEGRAM CHANNEL COPY ERROR]',
          err
        );


        await bot
          .deleteMessage(
            chatId,
            statusMsg.message_id
          )
          .catch(
            () => {}
          );


        return bot.sendMessage(

          chatId,

          `❌ <b>Upload Error</b>

<code>${escapeHtml(
            err.message
          )}</code>`,

          {
            parse_mode:
              'HTML'
          }
        );
      }
    }


    // =================================================
    // LINK RECEIVE
    // =================================================

    const incomingText =
      (msg.text || '').trim();


    if (
      !incomingText ||
      incomingText.startsWith('/')
    ) {

      return;
    }


    const urlRegex =
      /(https?:\/\/[^\s<>"']+)/gi;


    const urls =
      incomingText.match(
        urlRegex
      ) || [];


    if (
      urls.length === 0
    ) {

      return;
    }


    const statusMsg =
      await bot.sendMessage(

        chatId,

        `🔄 <i>Link process ho raha hai...</i>`,

        {
          parse_mode:
            'HTML'
        }
      );


    try {

      const targetUrl =
        urls[0];


      let extracted =
        await extractTeraboxLink(
          targetUrl
        );


      if (!extracted) {

        extracted = {

          url:
            targetUrl,

          name:
            'Web Video'
        };
      }


      const shortId =
        crypto
          .randomBytes(4)
          .toString('hex');


      const payload = {

        name:
          extracted.name,

        url:
          extracted.url,

        uploader:
          uploaderName
      };


      linkStore.set(
        shortId,
        payload
      );


      await redis.set(

        `video:${shortId}`,

        JSON.stringify(
          payload
        ),

        {
          ex:
            30 * 86400
        }
      );


      const playUrl =
        `${BASE_URL}/v/${shortId}`;


      await bot
        .deleteMessage(
          chatId,
          statusMsg.message_id
        )
        .catch(
          () => {}
        );


      return bot.sendMessage(

        chatId,

        `✨ <b>Aapka Stream Link:</b>

${playUrl}`,

        {
          parse_mode:
            'HTML'
        }
      );


    } catch (err) {

      await bot
        .deleteMessage(
          chatId,
          statusMsg.message_id
        )
        .catch(
          () => {}
        );


      return bot.sendMessage(

        chatId,

        `❌ <b>Error:</b>

<code>${escapeHtml(
          err.message
        )}</code>`,

        {
          parse_mode:
            'HTML'
        }
      );
    }

  }
);
