  try {
    const id = req.params.id;

    let data = linkStore.get(id);

    if (!data) {
      const raw = await redis.get(`video:${id}`);

      if (raw) {
        data =
          typeof raw === 'string'
            ? JSON.parse(raw)
            : raw;
      }
    }

    if (!data) {
      return res
        .status(404)
        .send('Video not found or link expired');
    }

    const streamUrl =
      `${BASE_URL}/stream/${id}`;

    const videoTitle =
      data.name || 'Video Player';

    res.send(`
<!DOCTYPE html>
<html lang="hi">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

