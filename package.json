// =====================================================
// 5. TELEGRAM STREAM ROUTE
// =====================================================

app.get('/stream/:id', async (req, res) => {

  try {

    const id = req.params.id;

    let data = linkStore.get(id);

    if (!data) {

      const raw =
        await redis.get(`video:${id}`);

      if (raw) {

        data =
          typeof raw === 'string'
            ? JSON.parse(raw)
            : raw;

      }
    }

    if (!data) {

      return res
        .status(404)
        .send('Stream not found');

    }

    if (!data.file_id) {

      return res
        .status(404)
        .send('Telegram file reference missing');

    }

    // -----------------------------------------------
    // Get Telegram file URL
    // -----------------------------------------------

    const fileUrl =
      await bot.getFileLink(data.file_id);

    // -----------------------------------------------
    // Forward browser Range header
    // -----------------------------------------------

    const headers = {
      'User-Agent':
        'MayaJaal-Stream-Engine/1.0'
    };

    if (req.headers.range) {

      headers.Range =
        req.headers.range;

    }

    // -----------------------------------------------
    // Stream directly from Telegram
    // -----------------------------------------------

    const telegramStream =
      await axios.get(
        fileUrl,
        {
          responseType: 'stream',

          headers,

          maxContentLength: Infinity,

          maxBodyLength: Infinity,

          timeout: 0,

          validateStatus: (status) =>
            status >= 200 &&
            status < 400
        }
      );

    // -----------------------------------------------
    // HTTP status
    // -----------------------------------------------

    if (
      telegramStream.status === 206 ||
      req.headers.range
    ) {

      res.status(206);

    } else {

      res.status(200);

    }

    // -----------------------------------------------
    // Headers
    // -----------------------------------------------

    res.setHeader(
      'Content-Type',
      telegramStream.headers[
        'content-type'
      ] || data.mime_type || 'video/mp4'
    );

    res.setHeader(
      'Accept-Ranges',
      'bytes'
    );

    if (
      telegramStream.headers[
        'content-range'
      ]
    ) {

      res.setHeader(
        'Content-Range',
        telegramStream.headers[
          'content-range'
        ]
      );

    }

    if (
      telegramStream.headers[
        'content-length'
      ]
    ) {

      res.setHeader(
        'Content-Length',
        telegramStream.headers[
          'content-length'
        ]
      );

    }

    // -----------------------------------------------
    // Pipe Telegram → Cloudflare/Railway → Player
    // -----------------------------------------------

    telegramStream.data.pipe(res);

    req.on('close', () => {

      if (
        telegramStream.data &&
        !telegramStream.data.destroyed
      ) {

        telegramStream.data.destroy();

      }

    });

  } catch (err) {

    console.error(
      '[STREAM ERROR]',
      err.message
    );

    if (!res.headersSent) {

      res
        .status(500)
        .send(
          'Telegram streaming error'
        );

    }

  }

});

// =====================================================
// 6. START SERVER
// =====================================================

app.listen(PORT, () => {

  console.log(
    `🚀 Server running on port ${PORT}`
  );

  console.log(
    `📺 Channel: ${CHANNEL_ID}`
  );

  console.log(
    `🎬 Player: ${BASE_URL}/v/:id`
  );

});

// =====================================================
// 7. BOT
// =====================================================

const bot = new TelegramBot(
  TOKEN,
  {
    baseApiUrl:
      TELEGRAM_API_BASE_URL,

    polling: {
      autoStart: true,

      params: {
        timeout: 10
      }
    }
  }
);

bot.on(
  'polling_error',
  async (error) => {

    console.error(
      '[POLLING ERROR]',
      error.message
    );

    if (
      error.message &&
      error.message.includes(
        '409 Conflict'
      )
    ) {

      await new Promise(
        resolve =>
          setTimeout(resolve, 4000)
      );

    }

  }
);

// =====================================================
// 8. HELPERS
// =====================================================

function escapeHtml(str = '') {

  return String(str).replace(
    /[&<>"']/g,

    (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[c])
  );

}

// =====================================================
// 9. START COMMAND
// =====================================================

bot.onText(
  /\/start/,
  async (msg) => {

    await bot.sendMessage(
      msg.chat.id,

      `🎬 <b>MayaJaal Stream Bot</b>

📤 Video bhejiye.

☁️ Video Cloudflare R2 par nahi jayegi.

📺 Video Telegram Channel mein store hogi.

🔗 Uske baad aapko MayaJaal Player Link milega.

▶️ Video aapke apne player mein Telegram se stream hogi.`,

      {
        parse_mode: 'HTML'
      }
    );

  }
);

// =====================================================
// 10. VIDEO UPLOAD → TELEGRAM CHANNEL
// =====================================================

bot.on(
  'message',
  async (msg) => {

    const chatId =
      msg.chat.id;

    const uploaderName =
      msg.from?.username
        ? `@${msg.from.username}`
        : (
            msg.from?.first_name ||
            'User'
          );

    // -----------------------------------------------
    // Detect video/document/animation
    // -----------------------------------------------

    const videoObj =
      msg.video ||
      msg.document ||
      msg.animation ||
      null;

    if (videoObj) {

      const fileId =
        videoObj.file_id;

      const fileName =
        videoObj.file_name ||
        `video_${Date.now()}.mp4`;

      const mimeType =
        videoObj.mime_type ||
        'video/mp4';

      const statusMsg =
        await bot.sendMessage(

          chatId,

          `⚡ <i>Video Telegram Channel mein upload ho rahi hai...</i>`,

          {
            parse_mode: 'HTML'
          }

        );

      try {

        // -------------------------------------------
        // Send/copy video to Telegram Channel
        // -------------------------------------------

        let channelMessage;

        if (msg.video) {

          channelMessage =
            await bot.sendVideo(

              CHANNEL_ID,

              fileId,

              {
                caption:
                  `🎬 ${fileName}\n\n` +
                  `👤 ${uploaderName}`
              }

            );

        } else {

          channelMessage =
            await bot.sendDocument(

              CHANNEL_ID,

              fileId,

              {
                caption:
                  `🎬 ${fileName}\n\n` +
                  `👤 ${uploaderName}`
              }

            );

        }

        // -------------------------------------------
        // Get actual Telegram file reference
        // -------------------------------------------

        let channelFileId =
          channelMessage?.video?.file_id ||
          channelMessage?.document?.file_id ||
          channelMessage?.animation?.file_id;

        if (!channelFileId) {

          throw new Error(
            'Channel file_id nahi mila'
          );

        }

        // -------------------------------------------
        // Save player reference
        // -------------------------------------------

        const shortId =
          crypto
            .randomBytes(6)
            .toString('hex');

        const payload = {

          name: fileName,

          file_id:
            channelFileId,

          channel_id:
            String(CHANNEL_ID),

          message_id:
            channelMessage.message_id,

          mime_type:
            mimeType,

          uploader:
            uploaderName,

          created_at:
            Date.now()

        };

        // Memory cache

        linkStore.set(
          shortId,
          payload
        );

        // Redis permanent metadata

        await redis.set(

          `video:${shortId}`,

          JSON.stringify(payload),

          {
            ex:
              3650 * 86400
          }

        );

        // -------------------------------------------
        // Your Player Link
        // -------------------------------------------

        const playUrl =
          `${BASE_URL}/v/${shortId}`;

        // -------------------------------------------
        // Delete processing message
        // -------------------------------------------

        await bot
          .deleteMessage(
            chatId,
            statusMsg.message_id
          )
          .catch(() => {});

        // -------------------------------------------
        // Send result
        // -------------------------------------------

        return bot.sendMessage(

          chatId,

          `✨ <b>Video Ready!</b>

📌 <b>File:</b>
${escapeHtml(fileName)}

📺 <b>Telegram Channel:</b>
Stored Successfully

🔗 <b>Your Player Link:</b>
${playUrl}`,

          {
            parse_mode: 'HTML',

            disable_web_page_preview:
              false
          }

        );

      } catch (err) {

        console.error(
          '[CHANNEL UPLOAD ERROR]',
          err
        );

        await bot
          .deleteMessage(
            chatId,
            statusMsg.message_id
          )
          .catch(() => {});

        return bot.sendMessage(

          chatId,

          `❌ <b>Upload Error</b>

<code>${escapeHtml(
            err.message
          )}</code>`,

          {
            parse_mode: 'HTML'
          }

        );

      }

}    // =================================================
    // LINK RECEIVE / TERABOX CONVERTER
    // =================================================

    const incomingText =
      (msg.text || '').trim();

    if (
      !incomingText ||
      incomingText.startsWith('/')
    ) {

      return;

    }

    const urlRegex =
      /(https?:\/\/[^\s<>"']+)/gi;

    const urls =
      incomingText.match(urlRegex) || [];

    if (
      urls.length === 0
    ) {

      return;

    }

    const statusMsg =
      await bot.sendMessage(

        chatId,

        `🔄 <i>Link process ho raha hai...</i>`,

        {
          parse_mode: 'HTML'
        }

      );

    try {

      const targetUrl =
        urls[0];

      let extracted =
        await extractTeraboxLink(
          targetUrl
        );

      if (!extracted) {

        extracted = {

          url:
            targetUrl,

          name:
            'Web Video'

        };

      }

      const shortId =
        crypto
          .randomBytes(6)
          .toString('hex');

      const payload = {

        name:
          extracted.name,

        url:
          extracted.url,

        uploader:
          uploaderName

      };

      linkStore.set(
        shortId,
        payload
      );

      await redis.set(

        `video:${shortId}`,

        JSON.stringify(payload),

        {
          ex:
            30 * 86400
        }

      );

      const playUrl =
        `${BASE_URL}/v/${shortId}`;

      await bot
        .deleteMessage(
          chatId,
          statusMsg.message_id
        )
        .catch(() => {});

      return bot.sendMessage(

        chatId,

        `✨ <b>Aapka Stream Link:</b>

${playUrl}`,

        {
          parse_mode: 'HTML'
        }

      );

    } catch (err) {

      await bot
        .deleteMessage(
          chatId,
          statusMsg.message_id
        )
        .catch(() => {});

      return bot.sendMessage(

        chatId,

        `❌ <b>Error:</b>

<code>${escapeHtml(
          err.message
        )}</code>`,

        {
          parse_mode: 'HTML'
        }

      );

    }

  }
);

// =====================================================
// TERABOX LINK RESOLVER
// =====================================================

async function extractTeraboxLink(
  rawUrl
) {

  try {

    let resolvedUrl =
      rawUrl;

    try {

      const resp =
        await axios.get(

          rawUrl,

          {
            maxRedirects: 5,

            headers: {

              'User-Agent':
                'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'

            },

            timeout: 8000

          }

        );

      if (
        resp.request?.res?.responseUrl
      ) {

        resolvedUrl =
          resp.request.res.responseUrl;

      }

    } catch (e) {}

    const match =
      resolvedUrl.match(
        /\/(s|sharing\/link\?surl=)([a-zA-Z0-9_-]+)/i
      ) ||

      resolvedUrl.match(
        /surl=([a-zA-Z0-9_-]+)/i
      ) ||

      rawUrl.match(
        /\/s\/([a-zA-Z0-9_-]+)/i
      );

    let shorturl =
      match
        ? (match[2] || match[1])
        : '';

    if (
      !shorturl &&
      resolvedUrl.includes('/s/')
    ) {

      shorturl =
        resolvedUrl
          .split('/s/')[1]
          .split(/[?&#]/)[0];

    }

    if (!shorturl) {

      return null;

    }

    const formattedKey =
      shorturl.startsWith('1')
        ? shorturl.substring(1)
        : shorturl;

    let rawCookie =
      process.env.TERABOX_COOKIE ||
      '';

    if (
      rawCookie &&
      !rawCookie.includes('ndus=')
    ) {

      rawCookie =
        `ndus=${rawCookie.trim()};`;

    }

    for (
      const k of [
        formattedKey,
        shorturl
      ]
    ) {

      try {

        const result =
          await axios.get(

            `https://www.1024tera.com/share/list?app_id=250528&shorturl=${k}&root=1`,

            {
              headers: {

                'User-Agent':
                  'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',

                'Referer':
                  'https://www.1024tera.com/',

                'Cookie':
                  rawCookie

              },

              timeout: 8000

            }

          );

        if (
          result.data?.errno === 0 &&
          result.data?.list?.length > 0
        ) {

          const file =
            result.data.list[0];

          const streamUrl =
            file.dlink ||
            file.direct_link ||
            file.url;

          if (streamUrl) {

            return {

              url:
                streamUrl,

              name:
                file.server_filename ||
                'Video'

            };

          }

        }

      } catch (err) {}

    }

  } catch (e) {}

  return null;

}
