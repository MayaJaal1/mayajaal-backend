{
  "version": 2,
  "rewrites": [
    {
      "source": "/version.json",
      "destination": "/public/version.json"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/public/.well-known/assetlinks.json"
    },
    {
      "source": "/app-release.apk",
      "destination": "https://github.com/MayaJaal1/mayajaall/releases/latest/download/app-release.apk"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/download.html",
      "destination": "/download.html"
    },
    {
      "source": "/v/:id*",
      "destination": "/player.html"
    },
    {
      "source": "/tb/:id*",
      "destination": "/player.html"
    },
    {
      "source": "/key",
      "destination": "/index.html"
    }
  ]
}
