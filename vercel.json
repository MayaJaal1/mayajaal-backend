{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
    "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "/public/.well-known/assetlinks.json"
    },
    {
      "src": "/v/(.*)",
      "dest": "/player.html"
    },
    {
      "src": "/tb/(.*)",
      "dest": "/player.html"
    },
    {
      "src": "/key",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
