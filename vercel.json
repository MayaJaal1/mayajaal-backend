{
  "version": 2,
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/public/.well-known/assetlinks.json"
    },
    {
      "source": "/version.json",
      "destination": "/bot.js"
    },
    {
      "source": "/check-update",
      "destination": "/bot.js"
    },
    {
      "source": "/api/check-update",
      "destination": "/bot.js"
    },
    {
      "source": "/app-release.apk",
      "destination": "[https://github.com/MayaJaal1/mayajaall/releases/latest/download/app-release.apk](https://github.com/MayaJaal1/mayajaall/releases/latest/download/app-release.apk)"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/download.html",
      "destination": "/download.html"
    },
    {
      "source": "/v/:id*",
      "destination": "/player.html"
    },
    {
      "source": "/tb/:id*",
      "destination": "/player.html"
    },
    {
      "source": "/key",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/bot.js"
    }
  ]
}
