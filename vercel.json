{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "/public/.well-known/assetlinks.json"
    },
    {
      "src": "/app-release.apk",
      "dest": "https://github.com/MayaJaal1/mayajaall/releases/latest/download/app-release.apk"
    },
    {
      "src": "/download",
      "dest": "/download.html"
    },
    {
      "src": "/v/(.*)",
      "dest": "/player.html"
    },
    {
      "src": "/tb/(.*)",
      "dest": "/player.html"
    },
    {
      "src": "/key",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
